# runner.env — the GitHub Actions runner the builder guest runs (story 032).
#
# RUNNER_SHA256 is the digest GitHub lists for actions-runner-linux-x64-$RUNNER_VERSION.tar.gz
# (release asset digest, same value in the release notes). guest-runner.sh refuses any other.
# Bump the runner within 30 days of a new release or GitHub stops handing it jobs; take a
# release at least 7 days old (constitution: no dependency younger than a week).
RUNNER_VERSION=2.338.0
RUNNER_SHA256=af4b794c1bc41d73d40535e3fe092a39f9679cd8d965954c2aca25a05ca41d32
# Id of the org runner group limited to obentoo/shidashi (`gh api orgs/obentoo/actions/runner-groups`).
# 1 is the org's default group, which every repository may use: narrow it before the first run.
RUNNER_GROUP_ID=1
