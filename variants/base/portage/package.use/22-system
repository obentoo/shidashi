# Flags removed 2026-09-09: absent from the package's IUSE, so Portage was
# ignoring them in silence. Verified token-by-token against the ebuilds and the
# md5-cache of both repos. Removed here: media-fonts/noto-emoji[buildfont]; sci-ml/ollama[nvidia]; sci-ml/ollama[cuda,-video_cards_amdgpu].

# Security
app-admin/doas persist
app-admin/sudo-rs system-names

# Boot
# NOTE: `sys-apps/systemd boot ukify` factored out to
# variants/init/systemd/portage/package.use (init-specific, Shidashi R8.4/R8.5).
sys-boot/grub mount

# Firmware
sys-firmware/intel-microcode initramfs

# Filesystem
# 'thin' dropped: it is the only thing pulling sys-block/thin-provisioning-tools,
# which is written in Rust and is the last package in the plan stuck on LLVM slot
# 21 — with the global LLVM_SLOT=22 it forces dev-lang/rust to be built FROM
# SOURCE just to serve it. lvm2 is in the set for dmsetup (the live ISO's
# dmsquash-live dracut module), not for thin volumes (lab, F22).
# TRADE-OFF: the live ISO will not activate LVM thin-provisioned volumes.
sys-fs/lvm2 lvm

# Containers
# No `kde` flag: sys-apps/flatpak declares IUSE="doc introspection policykit
# seccomp systemd test X" -- there is no KDE portal flag to set (2026-09-08).
sys-apps/flatpak policykit

