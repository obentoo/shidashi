dev-util/mingw64-toolchain abi_x86_32

# Nvidia
dev-util/nvidia-cuda-toolkit profiler
media-libs/libde265 dec265 enc265

# Messaging
# No net-im/telegram-desktop line: `qt6` and `qt6-imageformats` are not in its
# IUSE ("dbus enchant +fonts screencast wayland webkit +X"). Qt6 is an
# UNCONDITIONAL dependency there (>=dev-qt/qtbase-6.5:6), so the flags never
# expressed a choice -- they only looked like one (2026-09-08).
net-im/discord appindicator

# P2P
net-p2p/syncthing tools
net-p2p/transmission -gtk

# LLM
dev-util/hip -video_cards_amdgpu
acct-user/ollama cuda

# Cluster
