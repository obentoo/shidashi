# Flags removed 2026-09-09: absent from the package's IUSE, so Portage was
# ignoring them in silence. Verified token-by-token against the ebuilds and the
# md5-cache of both repos. Removed here: media-video/ffmpeg[cuda,libdrm,mp3]; media-video/handbrake[gtk]; media-video/vlc[vorbis]; media-gfx/inkscape[lcms]; media-gfx/graphviz[fontconfig].

# FFmpeg
media-video/ffmpeg chromium libass libaom modplug nvenc opencl openh264 opus speex srt svg theora truetype v4l vpx vorbis webp svt-av1 xvid jpeg2k fdk x264 lame

# Video tools
media-video/obs-studio fdk lua_single_target_luajit pipewire speex v4l
media-video/handbrake x265
media-video/simplescreenrecorder mp3 theora v4l vorbis vpx x264
media-video/mkvtoolnix gui

# Audio
# media-sound/pulseaudio removed: the package was split and the atom no longer
# exists -- only media-sound/pulseaudio-daemon does. NOTE what went with it: the
# `-daemon` flag WAS the mechanism keeping the PulseAudio daemon out of the image
# in favour of PipeWire. Whatever decides that now is not this file; confirm it in
# the next resolve (2026-09-08).
media-sound/pulseaudio-daemon ofono-headset
media-plugins/alsa-plugins libsamplerate speex
media-plugins/gst-plugins-meta flac libass libde265 nvcodec x264

# Graphics
# No media-gfx/blender pin: blender is in no set, and its LLVM_COMPAT tops out at
# ( {18..20} ) -- so if it ever entered the plan this pin would drag a THIRD llvm
# slot in, against the LLVM_SLOT=22 reasoning in make.conf (2026-09-08).
# The five entries marked (F37) below are REQUIRED by @bentoo-apps, not optional
# polish; Portage names the consumer for each. They only surface once the apps
# phase is resolved, which is why they were invisible while the lab measured the
# trunk alone (lab, 2026-08-30).
media-libs/gd fontconfig      # (F37) required by media-gfx/graphviz
media-libs/babl lcms          # (F37) required by media-gfx/gimp
media-libs/gegl lcms          # (F37) required by media-gfx/gimp
media-gfx/inkscape cdr exif imagemagick jpeg spell svg2
# No `-X` on gimp. The flag built a Wayland-only GIMP, while gimp reaches every
# graphical flavor through sets/imaging -> @extra-desktop -- including xfce and
# wm, which are X11. It would not have opened there. Both `X` and `wayland` are
# in the global USE, so GIMP now builds for both and XWayland covers the rest
# (2026-09-09).
media-gfx/imagemagick -openmp fftw fontconfig jbig jpeg jpeg2k lcms opencl openexr pango svg tiff webp truetype xml
media-gfx/qrencode png

# Image
media-libs/freeimage jpeg jpeg2k png webp
media-libs/opencv contrib contribdnn features2d

# GUI toolkits
gui-libs/gtk gstreamer
# No wxGTK:3.0 line: the only ebuild left is 3.2.8.1 with SLOT="${WXRELEASE}/3.2",
# so slot 3.0 matches nothing (2026-09-08).
x11-libs/wxGTK:3.2 -webkit

# `corefonts` was a global GRAPHICS flag; media-gfx/imagemagick is the only
# package in the plan that declares it (measured 2026-09-13).
media-gfx/imagemagick corefonts
