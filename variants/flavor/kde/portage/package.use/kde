# KDE Plasma Desktop

kde-misc/kdeconnect bluetooth
kde-plasma/spectacle share
kde-apps/dolphin semantic-desktop
kde-apps/ark zip
# -display-manager: plasma-meta would pull SDDM (or LightDM with -sddm) next to
# the display manager the kde stage installs per init (recipe.yaml init_sets).
kde-plasma/plasma-meta bluetooth cups -display-manager
kde-apps/kdenlive semantic-desktop
kde-frameworks/prison qml
kde-plasma/kde-cli-tools kdesu
kde-apps/kio-extras activities mtp taglib
kde-apps/gwenview activities share
kde-apps/okular epub markdown
kde-frameworks/kconfig qml
kde-plasma/kwin lock
# Upstream split kwin: kde-plasma/kwin is the Wayland compositor and
# kde-plasma/kwin-x11 the X11 one. kwin-x11 is no longer pulled: plasma-meta
# has no X since D24 (see plasma-x), so its `lock` line was dropped (2026-09-26).
kde-frameworks/sonnet qml
kde-frameworks/kfilemetadata taglib
kde-plasma/powerdevil brightness-control
sys-power/upower policykit

# Required by kde-frameworks/kdnssd, which declares
# net-dns/avahi[mdnsresponder-compat] outright. It reaches the plan through
# kde-misc/kdeconnect in sets/kde, so it belongs to this layer rather than the
# base: no other flavor pulls kdnssd (lab, 2026-09-12).
net-dns/avahi mdnsresponder-compat

# Flags dropped 2026-09-09, each absent from the package's IUSE and therefore
# ignored by Portage in silence: spectacle[kipi], dolphin[activities],
# kdenlive[share,v4l], gwenview[kipi], kio-extras[phonon], kwin[plasma], and the
# whole kde-frameworks/kitemmodels line (that package declares no IUSE at all).

# KDE-specific dependencies
sys-apps/systemd policykit
dev-qt/qt5compat qml icu
dev-qt/qtbase libproxy icu cups

# xdg-desktop-portal-kde
x11-base/xwayland libei

# KDE print manager
kde-plasma/print-manager gtk
