#!/bin/bash
# shidashi — the worker image's console tool (variants/worker).
#
#   shidashi kyomei | disk-init DISK SERIAL
#
# kyomei (共鳴, "resonance") opens a new pairing window: the worker announces itself
# over mDNS and shows a one-time code here; on the host, `shidashi kyomei` finds it
# and asks for that code. Nothing is typed at the worker. The window the boot opened
# (shidashi-kyomei.service) is stopped first, so this one owns the console.
#
# disk-init prepares the SHIDASHI-WORK disk; the host issues it with
# `shidashi worker disk-init WORKER DISK --confirm SERIAL`.
#
# Both run as root (re-executed through sudo). Logins over the network are key-only
# (/etc/ssh/sshd_config.d/10-shidashi-worker.conf).
set -euo pipefail

usage() {
  sed -n '4s/^# \{0,1\}//p' "$0"
}

if [[ ${1:-} == kyomei || ${1:-} == disk-init ]] && [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

case ${1:-} in
  kyomei)
    systemctl stop shidashi-kyomei.service
    exec /usr/bin/python3 /usr/local/lib/shidashi/kyomei_worker.py --listen
    ;;
  disk-init)
    shift
    exec /usr/bin/python3 /usr/local/lib/shidashi/worker_disk.py "$@"
    ;;
  "" | -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
